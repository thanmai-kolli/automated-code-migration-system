# In dev you normally need NOTHING here: `npm run dev` proxies /api -> Flask
# (see `server.proxy` in vite.config.js). Copy to `.env` only to override.

# Point the dev proxy at a backend on a different host/port:
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# For a production build, set the absolute API origin instead:
# VITE_API_BASE_URL=https://your-backend.example.com/api
